{
  "name": "codeint",
  "version": "1.0.0",
  "description": "Plataforma EdTech Gamificada para el Aprendizaje de Algoritmos en PSeInt - UTP 2026",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test:db": "node backend/config/database.js",
    "test": "node --test --test-concurrency=1",
    "test:security": "node --test tests/security.test.js",
    "db:create": "node scripts/create-database.js",
    "db:schema": "node scripts/apply-schema.js",
    "db:migrate": "node scripts/migrate.js",
    "db:audit": "node scripts/audit-database.js",
    "db:seed": "node scripts/seed.js",
    "db:sync-base-content": "node scripts/sync-base-content.js",
    "db:provision-app-role": "node scripts/provision-app-db-role.js",
    "db:bootstrap-superadmin": "node scripts/bootstrap-superadmin.js",
    "db:bootstrap-superadmin:prompt": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-superadmin.ps1",
    "security:production-check": "node scripts/check-production-readiness.js",
    "build:assets": "node scripts/build-frontend-assets.js",
    "db:test-superadmin": "node scripts/seed-test-superadmin.js",
    "db:test-setup": "node scripts/setup-test-db.js",
    "test:integration": "node scripts/with-test-db.js npm test"
  },
  "keywords": [
    "pseint",
    "kahoot",
    "algoritmos",
    "gamification",
    "utp",
    "edtech"
  ],
  "author": "codeInt Team - UTP 2026",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
