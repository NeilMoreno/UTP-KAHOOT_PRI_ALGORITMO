# ==============================================================
# codeInt - Plantilla de Variables de Entorno (.env.example)
# ==============================================================

PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=0

# Respaldo de conexión. DATABASE_URL tiene prioridad sobre estas variables.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=codeint_app
DB_PASSWORD=contraseña_exclusiva_generada_para_la_aplicacion
DB_NAME=codeint_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000

# Conexión de la API (privilegios mínimos). Si se define, ignora DB_*.
DATABASE_URL="postgresql://codeint_app:contraseña_exclusiva_generada@127.0.0.1:5432/codeint_db?schema=public"

# Cuenta propietaria: solamente migraciones, bootstrap y mantenimiento.
# No debe usarse para iniciar el servidor web.
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=5432
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=tu_contraseña_de_migraciones
MIGRATION_DB_NAME=codeint_db
# MIGRATION_DATABASE_URL="postgresql://postgres:tu_contraseña@127.0.0.1:5432/codeint_db"

JWT_SECRET=genera_una_clave_aleatoria_de_64_caracteres_o_mas
JWT_EXPIRES_IN=30m
JWT_ISSUER=codeint-api
JWT_AUDIENCE=codeint-web
BCRYPT_ROUNDS=12

EMAIL_PROVIDER=disabled
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM_ADDRESS=no-reply@codeintcorp.com
EMAIL_FROM_NAME=codeInt
EMAIL_REPLY_TO=
# URLs del frontend. La aplicación usa router por hash: el token se agrega como
# ?token=... dentro de la ruta (ej. http://localhost:3000/#/registro?token=...).
# Se entrecomillan porque dotenv interpreta "#" sin comillas como comentario.
FRONTEND_INVITATION_URL="http://localhost:3000/#/registro"
FRONTEND_PASSWORD_RESET_URL="http://localhost:3000/#/restablecer-password"

# Solo desarrollo local. En producción siempre debe ser false.
ALLOW_DEV_INVITATION_TOKEN_RESPONSE=false
ALLOW_TEST_PASSWORD_RESET_TOKEN_RESPONSE=false
# Solo con EMAIL_PROVIDER=disabled: devuelve dev_reset_url para probar la recuperación sin correo.
ALLOW_DEV_PASSWORD_RESET_TOKEN_RESPONSE=false

# Bootstrap manual: definir temporalmente, ejecutar el comando y retirar.
ALLOW_SUPERADMIN_BOOTSTRAP=0
BOOTSTRAP_SUPERADMIN_PASSWORD=

GEMINI_API_KEY=tu_api_key_de_gemini
# Con la clave gratuita de Google AI Studio los modelos "flash" suelen saturarse (503 / timeouts);
# los "flash-lite" responden rápido. Lista de modelos de tu clave: GET /v1beta/models.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=1200
# Generación del curso desde el sílabo (PDF): tiempo máximo, tokens de salida y reserva de cuota.
GEMINI_SYLLABUS_TIMEOUT_MS=120000
GEMINI_SYLLABUS_MAX_OUTPUT_TOKENS=24000
GEMINI_SYLLABUS_TOKEN_RESERVATION=60000
# Reserva conservadora por operación; el consumo final se reemplaza por el uso real informado por Gemini.
GEMINI_TOKEN_RESERVATION=16000

# Base de pruebas de integración (npm run db:test-setup / npm run test:integration).
TEST_DB_NAME=codeint_test
